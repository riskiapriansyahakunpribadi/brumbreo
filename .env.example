# NAMA: Daftar Variabel Lingkungan
# FUNGSI: Mencatat nama variabel rahasia yang hanya disimpan di dasbor Vercel, tidak pernah di kode browser.
# CARA MENGUBAH: Salin ke file .env.local untuk pengujian lokal dan isi nilainya sesuai layanan buletin yang dipakai.
# CARA MENAMBAH: Tambahkan baris KEY_BARU= tanpa nilai rahasia setiap kali endpoint server butuh kredensial baru.
# CARA MENGHAPUS: Hapus baris variabel jika layanan eksternal tidak lagi dipakai oleh api/newsletter.js.

NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_SECRET=